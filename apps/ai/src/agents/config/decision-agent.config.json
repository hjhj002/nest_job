  },
  "riskTypes": {
    "device_fault": {
      "name": "设备故障风险",
      "description": "变压器、断路器等设备故障"
    },
    "grid_operation": {
      "name": "电网运行风险",
      "description": "电压、频率、负荷等电网参数异常"
    },
    "outage_risk": {
      "name": "停电事件风险",
      "description": "可能导致停电的风险"
    },
    "safety_work": {
      "name": "安全工作风险",
      "description": "火灾、非授权进入等安全事件"
    },
    "unknown": {
      "name": "未知风险类型",
      "description": "无法识别的风险类型，使用通用策略"
    }
  },
