# 应用配置
NODE_ENV=development
PORT=3000
AI_PORT=3001

# 数据库配置 - PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/risk_control?schema=public"

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# FISCO BCOS 区块链配置
FISCO_BCOS_NODE_IP=your-node-ip
FISCO_BCOS_NODE_RPC_PORT=8545

# 智能合约地址
RISK_EVIDENCE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 账户私钥（hex格式，用于签名交易）
FISCO_BCOS_PRIVATE_KEY=your-private-key-hex

# LangChain配置
# OpenAI API（或使用其他兼容的LLM服务）
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# Redis配置（可选，用于分布式消息总线）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 日志级别
LOG_LEVEL=debug
